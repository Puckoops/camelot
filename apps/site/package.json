{
  "name": "@puckoops/camelot-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "dev": "tsx scripts/dev.ts",
    "prebuild": "npm run build -w @puckoops/camelot -w @puckoops/camelot-mcp && npm run generate",
    "build": "next build",
    "start": "next start --port 3030",
    "pretypecheck": "npm run generate",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@modelcontextprotocol/sdk": "~1.31.0",
    "@puckoops/camelot": "*",
    "@puckoops/camelot-mcp": "*",
    "@storybook/icons": "^2.1.0",
    "axe-core": "^4.13.0",
    "next": "16.3.8",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sugar-high": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
